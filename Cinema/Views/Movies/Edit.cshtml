@model Core.DTOs.MovieEditDto

@{
    ViewData["Title"] = "Edit Movie";
}

<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
      
            <div class="card shadow-sm border-0 rounded-3 bg-dark text-light p-4">
                <h1 class="text-center text-accent mb-3">@ViewData["Title"]</h1>
                <h4 class="mb-3">Movie Details</h4>
                <hr class="bg-light" />
                <form asp-action="Edit" method="post">
                    @await Html.PartialAsync("_MovieForm", Model)
                    <div class="form-group mt-3">
                      
                        <input type="submit" value="Save Changes" class="btn btn-outline-warning btn-extended btn-block" />
                    </div>
                </form>
                <div class="mt-3 text-center">
                    <a class="btn btn-outline-secondary btn-extended" asp-action="Index">
                        <i class="bi bi-arrow-left"></i> Back to List
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}