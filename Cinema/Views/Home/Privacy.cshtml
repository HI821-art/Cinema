@{
    ViewData["Title"] = "Privacy Policy";
}

<section class="container py-5">
    <!-- Заголовок сторінки -->
    <h1 class="text-center text-accent fw-bold">@ViewData["Title"]</h1>
    <p class="text-center text-muted mb-4">
        Your privacy is important to us. Below you’ll find details on how we collect, use, and protect your information.
    </p>

    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="card shadow-sm border-0 rounded-3 p-4 bg-dark">
                <section class="mb-4">
                   
                    <h2 class="text-light"><i class="bi bi-file-earmark-text"></i> Information Collection</h2>
                    <p class="text-muted">
                        We collect information through forms, cookies, and account registrations to enhance your experience.
                    </p>
                </section>

                <section class="mb-4">
                    <h2 class="text-light"><i class="bi bi-shield-lock"></i> How We Use Your Information</h2>
                    <p class="text-muted">
                        We use collected data to improve services, personalize content, and ensure security.
                    </p>
                </section>

                <section class="mb-4">
                    <h2 class="text-light"><i class="bi bi-lock"></i> Data Protection</h2>
                    <p class="text-muted">
                        We implement encryption and security measures to protect your data from unauthorized access.
                    </p>
                </section>

                <section>
                    <h2 class="text-light"><i class="bi bi-envelope"></i> Contact Us</h2>
                    <p class="text-muted">
                        Have questions? Contact us at <a href="mailto:support@cinema.com" class="text-accent">support@cinema.com</a>.
                    </p>
                </section>
            </div>
        </div>
    </div>
</section>