@model Data.Entities.Session

@{
    ViewData["Title"] = "Edit Session";
}

<section class="container py-5">
    <h1 class="text-center text-accent mb-4">Edit Session</h1>

    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card bg-dark text-light shadow-lg rounded-4">
                <div class="card-header">
                    <h4 class="mb-0">Session Details</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />
                        @await Html.PartialAsync("_SessionForm")
                        <div class="form-group mt-3">
                            <input type="submit" value="Save" class="btn btn-extended btn-primary" />
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="text-center mt-4">
        <a class="btn btn-extended btn-dark" asp-action="Index">Back to List</a>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}