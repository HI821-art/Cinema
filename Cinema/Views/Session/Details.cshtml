@model Data.Entities.Session
@inject UserManager<User> UserManager
@using Data.Entities
@using Microsoft.AspNetCore.Identity
@using System.Security.Claims

@{
    ViewData["Title"] = "Session Details";
    var currentCustomerId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    var isUserSignedIn = User.Identity?.IsAuthenticated ?? false;
    var availableSeats = Model.Seats?.Cast<Seat>().Count(s => !s.IsBooked);
    var totalSeats = Model.Seats?.Cast<Seat>().Count();
}

<section class="container py-5">
    <h2 class="text-center text-accent mb-3">@Model.Movie?.Title</h2>
    <p class="text-center text-muted">
        <strong>@Model.StartTime.ToShortDateString()</strong> at <strong>@Model.StartTime.ToShortTimeString()</strong>
    </p>

    <h4 class="text-center mt-4">
        Available Seats:
        <span class="badge bg-success p-2">@availableSeats</span> /
        <span class="badge bg-secondary p-2">@totalSeats</span>
    </h4>

    <div class="seat-grid mt-4">
        @foreach (var seat in Model.Seats.Cast<Seat>().OrderBy(s => int.Parse(s.SeatNumber)))
        {
            /* Визначаємо класи для стану місця:
            - "reserved": для місць, заброньованих іншим користувачем.
                - "selected": для місць, зарезервованих поточним користувачем.
                - "available": для вільних місць.
                Крім того, якщо користувач увійшов у систему і місце доступне для дії, додаємо клас "interactive". */
            var seatClass = "";
            if (seat.IsBooked)
            {
                seatClass = seat.UserId == currentCustomerId ? "selected" : "reserved";
            }
            else
            {
                seatClass = "available";
            }
            var interactiveClass = (isUserSignedIn) ? "interactive" : "";
            <div class="seat-btn @seatClass @interactiveClass"
                 data-seat-number="@seat.SeatNumber"
                 data-session-id="@Model.Id">
                @seat.SeatNumber
            </div>
        }
    </div>

    <div class="text-center mt-4">
        @if (isUserSignedIn)
        {
            <a asp-action="ReservedSeats" class="btn btn-outline-info btn-extended">
                <i class="bi bi-eye"></i> View Your Reserved Seats
            </a>
        }
        <a asp-action="Index" class="btn btn-outline-secondary btn-extended">
            <i class="bi bi-arrow-left"></i> Back to Sessions
        </a>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Знаходимо всі інтерактивні плитки місць
            var interactiveSeats = document.querySelectorAll('.seat-btn.interactive');
            interactiveSeats.forEach(function (seat) {
                seat.addEventListener('click', function () {
                    // Збираємо дані для запиту
                    var sessionId = seat.getAttribute('data-session-id');
                    var seatNumber = seat.getAttribute('data-seat-number');
                    var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                    const data = new URLSearchParams();
                    data.append('sessionId', sessionId);
                    data.append('seatNumber', seatNumber);

                    // Якщо місце має клас "selected", воно броньоване поточним користувачем і треба скасувати бронювання,
                    // інакше – бронюємо місце.
                    var isSelected = seat.classList.contains('selected');

                    // Формуємо URL залежно від дії
                    var url = isSelected
                        ? '/Session/CancelReservation/' + sessionId + '/' + seatNumber
                        : '/Session/Reserve';

                    fetch(url, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'RequestVerificationToken': token
                        },
                        body: data
                    })
                    .then(response => {
                        if (!response.ok) {
                            throw new Error('Request failed');
                        }
                        // Якщо дія пройшла успішно:
                        if (isSelected) {
                            // При скасуванні бронювання, видаляємо клас "selected" і додаємо "available"
                            seat.classList.remove('selected');
                            seat.classList.remove('reserved');
                            seat.classList.add('available');
                        } else {
                            // При бронюванні, видаляємо клас "available" та додаємо "selected"
                            seat.classList.remove('available');
                            seat.classList.add('selected');
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        alert('Помилка при обробці запиту.');
                    });
                });
            });
        });
    </script>
}